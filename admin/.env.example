# Configuración del panel de administración. Copia este fichero a `.env.local` (no se versiona) y rellénalo.
# Sin estos valores el panel arranca en MODO DEMO: solo lectura, con los valores base del juego.

# URL del proyecto de Supabase (Project Settings → API).
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Clave PÚBLICA: la "Publishable key" (sb_publishable_...) o la "anon public" antigua (eyJ...).
# Es la misma que usa el juego. Puede verse: la seguridad la dan RLS y las funciones de 002_panel.sql.
# NUNCA la service_role ni una Secret key (sb_secret_...): el panel se niega a usarlas.
VITE_SUPABASE_ANON_KEY=

# Plantilla del email sintético: la misma que EMAIL_PLANTILLA del juego. {usuario} se sustituye por el nombre.
VITE_EMAIL_PLANTILLA={usuario}@jugadores.valdehierro.app

# Opcional: ruta desde la que se sirve (GitHub Pages: /hoja-del-alba/). Por defecto "./".
# VITE_BASE=./
